{
  "name": "gitland",
  "displayName": "Gitland",
  "description": "Free git superpowers: beautiful commit graph, inline blame, tickets → branches and pull requests for Azure DevOps & GitHub.",
  "version": "0.23.2",
  "publisher": "jay-boo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jay-boo/gitland.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "graph",
    "blame",
    "azure devops",
    "pull request",
    "work items"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:gitland.pullRequest",
    "onWebviewPanel:gitland.ticket",
    "onWebviewPanel:gitland.compare",
    "onWebviewPanel:gitland.history",
    "onWebviewPanel:gitland.dashboard",
    "onWebviewPanel:gitland.cleanup",
    "onWebviewPanel:gitland.newPullRequest",
    "onWebviewPanel:gitland.newRelease",
    "onWebviewPanel:gitland.graph",
    "onWebviewPanel:gitland.changes"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitland.showGraph",
        "title": "Show Commit Graph",
        "category": "Gitland",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitland.toggleFileBlame",
        "title": "Toggle File Blame",
        "category": "Gitland",
        "icon": "$(person)"
      },
      {
        "command": "gitland.toggleInlineBlame",
        "title": "Toggle Inline Blame",
        "category": "Gitland"
      },
      {
        "command": "gitland.fileHistory",
        "title": "Show File History",
        "category": "Gitland",
        "icon": "$(history)"
      },
      {
        "command": "gitland.lineHistory",
        "title": "Show Line History",
        "category": "Gitland"
      },
      {
        "command": "gitland.tickets.sources",
        "title": "Ticket Sources…",
        "category": "Gitland",
        "icon": "$(settings)"
      },
      {
        "command": "gitland.tickets.refresh",
        "title": "Refresh Tickets",
        "category": "Gitland",
        "icon": "$(refresh)"
      },
      {
        "command": "gitland.tickets.startWork",
        "title": "Start Work (Create Branch)",
        "category": "Gitland",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitland.tickets.startWorkById",
        "title": "Start Work From Ticket…",
        "category": "Gitland",
        "icon": "$(add)"
      },
      {
        "command": "gitland.tickets.show",
        "title": "Show Ticket",
        "category": "Gitland",
        "icon": "$(issues)"
      },
      {
        "command": "gitland.tickets.open",
        "title": "Open Ticket in Browser",
        "category": "Gitland",
        "icon": "$(link-external)"
      },
      {
        "command": "gitland.tickets.copyId",
        "title": "Copy Ticket ID",
        "category": "Gitland"
      },
      {
        "command": "gitland.prs.refresh",
        "title": "Refresh Pull Requests",
        "category": "Gitland",
        "icon": "$(refresh)"
      },
      {
        "command": "gitland.prs.create",
        "title": "Create Pull Request",
        "category": "Gitland",
        "icon": "$(git-pull-request-create)"
      },
      {
        "command": "gitland.prs.show",
        "title": "Show Pull Request",
        "category": "Gitland",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "gitland.prs.open",
        "title": "Open Pull Request in Browser",
        "category": "Gitland",
        "icon": "$(link-external)"
      },
      {
        "command": "gitland.prs.checkout",
        "title": "Checkout Pull Request Branch",
        "category": "Gitland",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitland.setAzurePat",
        "title": "Set Azure DevOps Personal Access Token",
        "category": "Gitland"
      },
      {
        "command": "gitland.clearCredentials",
        "title": "Clear Stored Tokens",
        "category": "Gitland"
      },
      {
        "command": "gitland.switchAzureAccount",
        "title": "Switch Azure DevOps Account",
        "category": "Gitland",
        "icon": "$(account)"
      },
      {
        "command": "gitland.switchGitHubAccount",
        "title": "Switch GitHub Account",
        "category": "Gitland",
        "icon": "$(github)"
      },
      {
        "command": "gitland.showLog",
        "title": "Show Log",
        "category": "Gitland",
        "icon": "$(output)"
      },
      {
        "command": "gitland.toggleCodeLens",
        "title": "Toggle Blame CodeLens",
        "category": "Gitland"
      },
      {
        "command": "gitland.toggleFileBlameOff",
        "title": "Hide File Blame",
        "category": "Gitland",
        "icon": "$(person-filled)"
      },
      {
        "command": "gitland.showGraphInEditor",
        "title": "Show Commit Graph in Editor",
        "category": "Gitland",
        "icon": "$(link-external)"
      },
      {
        "command": "gitland.clearAvatarCache",
        "title": "Clear Avatar Cache",
        "category": "Gitland"
      },
      {
        "command": "gitland.chooseAvatarStyle",
        "title": "Choose Author Picture Style",
        "category": "Gitland",
        "icon": "$(account)"
      },
      {
        "command": "gitland.showGraphView",
        "title": "Show Commit Graph in Sidebar",
        "category": "Gitland",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "gitland.showGraphInPanel",
        "title": "Show Commit Graph in Bottom Panel",
        "category": "Gitland",
        "icon": "$(layout-panel)"
      },
      {
        "command": "gitland.toggleChat",
        "title": "Toggle Chat Panel",
        "category": "Gitland"
      },
      {
        "command": "gitland.compare",
        "title": "Compare Branches or Tags…",
        "category": "Gitland",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitland.releases.create",
        "title": "Create Release…",
        "category": "Gitland",
        "icon": "$(tag)"
      },
      {
        "command": "gitland.releases.refresh",
        "title": "Refresh Releases",
        "category": "Gitland",
        "icon": "$(refresh)"
      },
      {
        "command": "gitland.rebase.interactive",
        "title": "Interactive Rebase…",
        "category": "Gitland",
        "icon": "$(list-ordered)"
      },
      {
        "command": "gitland.branches.cleanup",
        "title": "Clean Up Branches…",
        "category": "Gitland",
        "icon": "$(trash)"
      },
      {
        "command": "gitland.worktrees",
        "title": "Worktrees…",
        "category": "Gitland",
        "icon": "$(window)"
      },
      {
        "command": "gitland.worktrees.open",
        "title": "Open Branch in a New Worktree",
        "category": "Gitland"
      },
      {
        "command": "gitland.pipelines.openLatest",
        "title": "Open the Latest CI Run",
        "category": "Gitland"
      },
      {
        "command": "gitland.explainLines",
        "title": "Explain These Lines (AI)",
        "category": "Gitland",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitland.search",
        "title": "Search Everywhere…",
        "category": "Gitland",
        "icon": "$(search)"
      },
      {
        "command": "gitland.dashboard",
        "title": "Dashboard",
        "category": "Gitland",
        "icon": "$(dashboard)"
      },
      {
        "command": "gitland.showChangesInPanel",
        "title": "Show Changes in Bottom Panel",
        "category": "Gitland",
        "icon": "$(layout-panel)"
      },
      {
        "command": "gitland.showChangesView",
        "title": "Show Changes in Sidebar",
        "category": "Gitland",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "gitland.showChangesInEditor",
        "title": "Open Changes in Editor",
        "category": "Gitland",
        "icon": "$(link-external)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitlandSidebar",
          "title": "Gitland",
          "icon": "media/activity.svg"
        }
      ],
      "panel": [
        {
          "id": "gitlandPanel",
          "title": "Gitland",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "gitlandSidebar": [
        {
          "type": "webview",
          "id": "gitland.changesView",
          "name": "Changes",
          "icon": "media/activity.svg",
          "visibility": "visible",
          "initialSize": 12
        },
        {
          "type": "webview",
          "id": "gitland.graphView",
          "name": "Graph",
          "icon": "media/activity.svg",
          "visibility": "visible",
          "initialSize": 4
        },
        {
          "id": "gitland.tickets",
          "name": "My Tickets",
          "visibility": "visible",
          "initialSize": 2,
          "type": "webview"
        },
        {
          "id": "gitland.prs",
          "name": "Pull Requests",
          "visibility": "visible",
          "initialSize": 2,
          "type": "webview"
        },
        {
          "type": "webview",
          "id": "gitland.releases",
          "name": "Releases",
          "icon": "media/activity.svg",
          "visibility": "collapsed",
          "initialSize": 1
        }
      ],
      "gitlandPanel": [
        {
          "type": "webview",
          "id": "gitland.graphPanelView",
          "name": "Commit Graph",
          "icon": "media/activity.svg"
        },
        {
          "type": "webview",
          "id": "gitland.changesPanelView",
          "name": "Changes",
          "icon": "media/activity.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gitland.tickets.startWorkById",
          "when": "view == gitland.tickets",
          "group": "navigation@1"
        },
        {
          "command": "gitland.tickets.refresh",
          "when": "view == gitland.tickets",
          "group": "navigation@3"
        },
        {
          "command": "gitland.tickets.sources",
          "when": "view == gitland.tickets",
          "group": "navigation@4"
        },
        {
          "command": "gitland.prs.create",
          "when": "view == gitland.prs",
          "group": "navigation@1"
        },
        {
          "command": "gitland.prs.refresh",
          "when": "view == gitland.prs",
          "group": "navigation@2"
        },
        {
          "command": "gitland.switchAzureAccount",
          "when": "view == gitland.tickets || view == gitland.prs",
          "group": "9_account@1"
        },
        {
          "command": "gitland.switchGitHubAccount",
          "when": "view == gitland.tickets || view == gitland.prs",
          "group": "9_account@2"
        },
        {
          "command": "gitland.showLog",
          "when": "view == gitland.tickets || view == gitland.prs",
          "group": "9_account@3"
        },
        {
          "command": "gitland.showGraphInPanel",
          "when": "view == gitland.graphView",
          "group": "navigation@1"
        },
        {
          "command": "gitland.showGraphInEditor",
          "when": "view == gitland.graphView || view == gitland.graphPanelView",
          "group": "navigation@2"
        },
        {
          "command": "gitland.showGraphView",
          "when": "view == gitland.graphPanelView",
          "group": "navigation@1"
        },
        {
          "command": "gitland.releases.create",
          "when": "view == gitland.releases",
          "group": "navigation@1"
        },
        {
          "command": "gitland.releases.refresh",
          "when": "view == gitland.releases",
          "group": "navigation@2"
        },
        {
          "command": "gitland.dashboard",
          "when": "view =~ /^gitland\\.(changesView|graphView|tickets|prs|releases)$/",
          "group": "navigation@0"
        },
        {
          "command": "gitland.search",
          "when": "view == gitland.graphView",
          "group": "navigation@0"
        },
        {
          "command": "gitland.showChangesInPanel",
          "when": "view == gitland.changesView",
          "group": "navigation@8"
        },
        {
          "command": "gitland.showChangesView",
          "when": "view == gitland.changesPanelView",
          "group": "navigation@1"
        },
        {
          "command": "gitland.showChangesInEditor",
          "when": "view == gitland.changesView || view == gitland.changesPanelView",
          "group": "navigation@7"
        }
      ],
      "scm/title": [
        {
          "command": "gitland.showGraph",
          "group": "navigation@-1",
          "when": "scmProvider == git"
        }
      ],
      "editor/title": [
        {
          "command": "gitland.toggleFileBlame",
          "group": "navigation@90",
          "when": "resourceScheme == file && config.gitland.blame.showEditorTitleButton && !gitland.fileBlameOn"
        },
        {
          "command": "gitland.toggleFileBlameOff",
          "group": "navigation@90",
          "when": "resourceScheme == file && config.gitland.blame.showEditorTitleButton && gitland.fileBlameOn"
        }
      ],
      "editor/context": [
        {
          "command": "gitland.toggleFileBlame",
          "group": "gitland@1",
          "when": "resourceScheme == file"
        },
        {
          "command": "gitland.fileHistory",
          "group": "gitland@2",
          "when": "resourceScheme == file"
        },
        {
          "command": "gitland.lineHistory",
          "group": "gitland@3",
          "when": "resourceScheme == file"
        },
        {
          "command": "gitland.explainLines",
          "when": "resourceScheme == file",
          "group": "gitland@3"
        }
      ],
      "explorer/context": [
        {
          "command": "gitland.fileHistory",
          "group": "gitland@1",
          "when": "!explorerResourceIsFolder"
        }
      ],
      "commandPalette": [
        {
          "command": "gitland.tickets.startWork",
          "when": "false"
        },
        {
          "command": "gitland.tickets.open",
          "when": "false"
        },
        {
          "command": "gitland.tickets.copyId",
          "when": "false"
        },
        {
          "command": "gitland.prs.open",
          "when": "false"
        },
        {
          "command": "gitland.prs.checkout",
          "when": "false"
        },
        {
          "command": "gitland.toggleFileBlameOff",
          "when": "false"
        },
        {
          "command": "gitland.worktrees.open",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gitland.showGraph",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      },
      {
        "command": "gitland.toggleFileBlame",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorTextFocus"
      },
      {
        "command": "gitland.search",
        "key": "ctrl+alt+shift+f",
        "mac": "cmd+alt+shift+f"
      },
      {
        "command": "gitland.toggleChat",
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+alt+shift+c"
      }
    ],
    "configuration": {
      "title": "Gitland",
      "properties": {
        "gitland.blame.inline.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show blame of the current line at the end of the line."
        },
        "gitland.blame.inline.format": {
          "type": "string",
          "default": "${author}, ${ago} • ${message}",
          "description": "Inline blame format. Placeholders: ${author}, ${ago}, ${date}, ${message}, ${sha}."
        },
        "gitland.blame.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show blame of the current line in the status bar."
        },
        "gitland.blame.showEditorTitleButton": {
          "type": "boolean",
          "default": true,
          "description": "Show the 'Toggle File Blame' button in the editor title bar."
        },
        "gitland.graph.maxCommits": {
          "type": "number",
          "default": 400,
          "description": "Number of commits loaded in the graph at once (more can be loaded on demand)."
        },
        "gitland.branch.template": {
          "type": "string",
          "default": "${prefix}/${id}-${title}",
          "description": "Branch name template when starting work on a ticket. Placeholders: ${prefix}, ${id}, ${title}, ${user}."
        },
        "gitland.branch.prefixByType": {
          "type": "object",
          "default": {
            "Bug": "fix",
            "Task": "feature",
            "User Story": "feature",
            "Product Backlog Item": "feature",
            "Feature": "feature",
            "Epic": "feature",
            "Issue": "feature"
          },
          "description": "Branch prefix per ticket type. Unknown types use 'feature'."
        },
        "gitland.branch.fetchBeforeCreate": {
          "type": "boolean",
          "default": true,
          "description": "Fetch the remote before creating a branch from a ticket."
        },
        "gitland.changes.autoStageAll": {
          "type": "boolean",
          "default": false,
          "description": "Commit all changes without asking when nothing is staged (Changes view)."
        },
        "gitland.changes.commitMessageInstructions": {
          "type": "string",
          "default": "",
          "markdownDescription": "Extra instructions for the ✨ generated commit messages, e.g. `Write in French` or `Use Conventional Commits`."
        },
        "gitland.changes.commitMessageModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Language model family for the ✨ commit messages (e.g. `gpt-4o-mini`, `claude-sonnet-4`). Empty: a fast Copilot model."
        },
        "gitland.changes.pullRebase": {
          "type": "boolean",
          "default": false,
          "description": "Pull with --rebase from the Changes view."
        },
        "gitland.tickets.sources": {
          "type": "array",
          "default": [],
          "markdownDescription": "Azure DevOps projects the tickets come from, when they are not in the repository's project (e.g. a shared backlog). Empty = the repository's project. Easiest with **Gitland: Ticket Sources…** (⚙ in the Tickets view).",
          "items": {
            "type": "object",
            "required": [
              "organization",
              "project"
            ],
            "properties": {
              "organization": {
                "type": "string",
                "description": "Azure DevOps organization (dev.azure.com/<organization>)."
              },
              "project": {
                "type": "string",
                "description": "Project that holds the work items."
              },
              "wiql": {
                "type": "string",
                "description": "WIQL for 'My Tickets' in this project (default: gitland.azureDevOps.wiql; @project is this project)."
              }
            }
          }
        },
        "gitland.azureDevOps.wiql": {
          "type": "string",
          "default": "SELECT [System.Id] FROM WorkItems WHERE [System.TeamProject] = @project AND [System.AssignedTo] = @Me AND [System.State] NOT IN ('Closed', 'Done', 'Removed', 'Resolved', 'Completed') ORDER BY [System.ChangedDate] DESC",
          "description": "WIQL query used to list 'My Tickets' in Azure DevOps."
        },
        "gitland.azureDevOps.activateOnStartWork": {
          "type": "boolean",
          "default": false,
          "description": "Move the Azure DevOps work item to the 'Active' state when you start work on it."
        },
        "gitland.pr.draftByDefault": {
          "type": "boolean",
          "default": false,
          "description": "Create pull requests as draft by default."
        },
        "gitland.blame.toggleMode": {
          "type": "string",
          "enum": [
            "file",
            "window"
          ],
          "enumDescriptions": [
            "File blame is toggled for the current file only",
            "File blame is toggled for every file in the window"
          ],
          "default": "file",
          "description": "How 'Toggle File Blame' behaves (same as GitLens' blame toggle mode)."
        },
        "gitland.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show GitLens-style blame CodeLens (most recent change and authors) above the file and its classes/functions."
        },
        "gitland.codeLens.scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "document",
              "containers",
              "blocks"
            ]
          },
          "default": [
            "document",
            "containers",
            "blocks"
          ],
          "description": "Where to show blame CodeLens: 'document' = top of file, 'containers' = classes/modules, 'blocks' = functions/methods."
        },
        "gitland.graph.showStashes": {
          "type": "boolean",
          "default": true,
          "description": "Show stash entries in the Commit Graph."
        },
        "gitland.graph.avatars": {
          "type": "boolean",
          "default": true,
          "description": "Show author pictures in the commit graph."
        },
        "gitland.blame.avatars": {
          "type": "boolean",
          "default": true,
          "description": "Show author pictures in blame hovers."
        },
        "gitland.avatars.defaultStyle": {
          "type": "string",
          "enum": [
            "pixel",
            "geometric",
            "marble",
            "rings",
            "initials",
            "dicebear-notionists",
            "dicebear-notionists-neutral",
            "dicebear-lorelei",
            "dicebear-lorelei-neutral",
            "dicebear-avataaars",
            "dicebear-avataaars-neutral",
            "dicebear-adventurer",
            "dicebear-adventurer-neutral",
            "dicebear-big-ears",
            "dicebear-big-ears-neutral",
            "dicebear-big-smile",
            "dicebear-micah",
            "dicebear-open-peeps",
            "dicebear-personas",
            "dicebear-dylan",
            "dicebear-miniavs",
            "dicebear-croodles",
            "dicebear-croodles-neutral",
            "dicebear-fun-emoji",
            "dicebear-thumbs",
            "dicebear-bottts",
            "dicebear-bottts-neutral",
            "dicebear-pixel-art",
            "dicebear-pixel-art-neutral",
            "dicebear-icons",
            "dicebear-identicon",
            "dicebear-initials",
            "dicebear-rings",
            "dicebear-shapes",
            "dicebear-glass",
            "robohash",
            "identicon",
            "retro",
            "monsterid",
            "wavatar",
            "mp"
          ],
          "enumDescriptions": [
            "Symmetric 5×5 identicon, drawn locally",
            "Bauhaus shapes, drawn locally",
            "Soft blurred blobs, drawn locally",
            "Concentric arcs, drawn locally",
            "Initials on a color, drawn locally",
            "DiceBear “notionists”",
            "DiceBear “notionists-neutral” (face only, calmer)",
            "DiceBear “lorelei”",
            "DiceBear “lorelei-neutral” (face only, calmer)",
            "DiceBear “avataaars”",
            "DiceBear “avataaars-neutral” (face only, calmer)",
            "DiceBear “adventurer”",
            "DiceBear “adventurer-neutral” (face only, calmer)",
            "DiceBear “big-ears”",
            "DiceBear “big-ears-neutral” (face only, calmer)",
            "DiceBear “big-smile”",
            "DiceBear “micah”",
            "DiceBear “open-peeps”",
            "DiceBear “personas”",
            "DiceBear “dylan”",
            "DiceBear “miniavs”",
            "DiceBear “croodles”",
            "DiceBear “croodles-neutral” (face only, calmer)",
            "DiceBear “fun-emoji”",
            "DiceBear “thumbs”",
            "DiceBear “bottts”",
            "DiceBear “bottts-neutral” (face only, calmer)",
            "DiceBear “pixel-art”",
            "DiceBear “pixel-art-neutral” (face only, calmer)",
            "DiceBear “icons”",
            "DiceBear “identicon”",
            "DiceBear “initials”",
            "DiceBear “rings”",
            "DiceBear “shapes”",
            "DiceBear “glass”",
            "Robots from Gravatar (GitLens default)",
            "Gravatar identicon",
            "Gravatar retro pixels",
            "Gravatar monsters",
            "Gravatar faces",
            "Gravatar silhouette"
          ],
          "default": "pixel",
          "markdownDescription": "Picture used when an author has no profile photo (a real Azure DevOps / GitHub / Gravatar photo always wins). Drawn locally in the graph colors, or from [DiceBear](https://www.dicebear.com) or Gravatar. Preview them with **Gitland: Choose Author Picture Style**."
        },
        "gitland.azureDevOps.browserSignIn": {
          "type": "boolean",
          "default": true,
          "description": "Sign in to Azure DevOps through the browser instead of the Windows account dialog (sets 'microsoft-authentication.implementation' to 'msal-no-broker'). The Windows dialog is often blocked on laptops not managed by the organization."
        },
        "gitland.graph.layout": {
          "type": "string",
          "enum": [
            "editor",
            "panel"
          ],
          "enumDescriptions": [
            "Prefer showing the Commit Graph in the editor area",
            "Prefer showing the Commit Graph as a view (Gitland sidebar)"
          ],
          "default": "panel",
          "description": "Preferred layout of the Commit Graph (same as GitLens' gitlens.graph.layout)."
        },
        "gitland.graph.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a 'Graph' button in the status bar (like GitLens)."
        },
        "gitland.tickets.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the ticket of the current branch in the status bar (click to see it)."
        },
        "gitland.pr.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the pull request of the current branch in the status bar (click to see it)."
        },
        "gitland.pr.addMeAsReviewer": {
          "type": "boolean",
          "default": true,
          "description": "Add yourself as an optional reviewer of the pull requests you create (Azure DevOps)."
        },
        "gitland.pr.descriptionInstructions": {
          "type": "string",
          "default": "",
          "markdownDescription": "Extra instructions for the ✨ generated pull request title and description, e.g. `Write in French`."
        },
        "gitland.releases.notesInstructions": {
          "type": "string",
          "default": "",
          "markdownDescription": "Extra instructions for the ✨ release notes, e.g. `Write in French`."
        },
        "gitland.graph.pipelines": {
          "type": "boolean",
          "default": true,
          "description": "Show the CI status (Azure Pipelines / GitHub Actions) of the commits in the Commit Graph."
        },
        "gitland.pipelines.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the CI status of the current branch in the status bar."
        },
        "gitland.ai.explainInstructions": {
          "type": "string",
          "default": "",
          "markdownDescription": "Extra instructions for ✨ Explain, e.g. `Answer in French`."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run typecheck && npx -y node@20 node_modules/@vscode/vsce/vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production",
    "test": "npm run build && node test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "~1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
